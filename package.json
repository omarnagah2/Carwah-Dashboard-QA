{
  "name": "carwah-dashboard-playwright",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright TypeScript automation project for the Carwah Dashboard.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report",
    "codegen": "playwright codegen"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.8.3"
  }
}
